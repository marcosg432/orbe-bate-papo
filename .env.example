# Copie para server/.env apenas se quiser alterar os padrões.
# O desenvolvimento local funciona sem arquivo .env.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=data/chat.sqlite
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# O cliente usa a mesma origem em desenvolvimento (proxy do Vite).
# Defina estas variáveis só em um build apontando para outra origem.
# VITE_API_URL=
# VITE_SOCKET_URL=
